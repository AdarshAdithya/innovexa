# Model infrastructure provided at the event (any OpenAI-compatible endpoint).
# Leave LLM_BASE_URL empty to run fully offline (deterministic parser + note reader + template explainer).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60

# Optional: require an X-API-Key header on every request (except /health)
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=120

# tfidf (default, no downloads) or chroma (needs requirements-optional.txt)
RAG_BACKEND=tfidf
